[TEMPLATE]
# AGRIQ AI environment template — copy to .env and fill values.
# NEVER commit .env. Secrets live only here or in deployment secrets.

# --- Core (required) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AGRIQ_SECRET_KEY=replace-with-a-long-random-secret
AGRIQ_ENV=development

# --- Session security ---
# Set AGRIQ_COOKIE_SECURE=1 and AGRIQ_ENABLE_HSTS=1 only behind HTTPS.
AGRIQ_COOKIE_SECURE=0
AGRIQ_ENABLE_HSTS=0

# --- Database ---
# Local development default is SQLite. Production REQUIRES PostgreSQL.
DATABASE_URL=sqlite:///agriq.db

# --- Rate limiting ---
# Local dev uses in-memory storage. Production REQUIRES Redis.
RATELIMIT_STORAGE_URI=memory://

# --- Flask ---
FLASK_DEBUG=0

# --- Uploads ---
# Soil reports + observation images are stored privately under this folder.
# Leave empty to use apps/api/uploads (created automatically; not web-servable).
AGRIQ_UPLOAD_FOLDER=

# --- External data freshness (seconds) ---
WEATHER_SNAPSHOT_TTL_SECONDS=1800
MARKET_SNAPSHOT_TTL_SECONDS=21600

# --- Optional: Gemini generative AI (farmer assistant) ---
# Without a key the farmer assistant reports an explicit unavailable state;
# the Student/Research workspace uses the rule-based knowledge engine.
# No scripted answer is ever labelled as AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30

# --- Phase 2: Farm Copilot ---
# Bounded prompt size (tokens) sent to the model.
COPILOT_MAX_CONTEXT_TOKENS=4000
# Raw knowledge documents archive root (outside the public static tree).
KNOWLEDGE_STORAGE_PATH=
# Minimum lexical relevance (0-1) for a knowledge passage to be used.
KNOWLEDGE_MIN_RELEVANCE_SCORE=0.18
WEATHER_CACHE_TTL_SECONDS=1800

# --- Optional: official mandi prices (AGMARKNET via data.gov.in) ---
# Without a key the market feed reports an unavailable state. No prices
# are ever generated locally.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_MARKET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# --- Optional: voice interface (Phase 3) ---
# With nothing configured, voice reports unavailable states and text input
# remains fully functional. Capabilities are computed from real config.
VOICE_ASR_PROVIDER=
VOICE_TTS_PROVIDER=
VOICE_TRANSLATION_PROVIDER=

# Bhashini (Government of India national language platform) — cloud ASR/TTS.
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
BHASHINI_BASE_URL=

# Local AI4Bharat models (server-side inference, Apache-2.0/CC-BY licences).
INDICCONFORMER_MODEL_PATH_OR=
INDICCONFORMER_MODEL_PATH_HI=
INDIAN_ENGLISH_ASR_MODEL_PATH=
INDIC_TTS_MODEL_PATH_OR=
INDIC_TTS_MODEL_PATH_HI=
INDIC_TTS_MODEL_PATH_EN=

VOICE_MAX_FILE_SIZE_MB=10
VOICE_MAX_DURATION_SECONDS=60
VOICE_AUDIO_RETENTION_HOURS=0
VOICE_TEMP_STORAGE_PATH=
VOICE_PROVIDER_TIMEOUT_SECONDS=
VOICE_QUEUE_MAX_RETRIES=

# --- Phase 4: crop-image intelligence (all optional; with no approved model
# registered the image feature reports an honest unavailable state) ---
IMAGE_MAX_FILE_SIZE_MB=5
IMAGE_MAX_DIMENSION=6000
IMAGE_STORAGE_PATH=
IMAGE_DECODER_TIMEOUT_SECONDS=10
IMAGE_MAX_PER_REQUEST=1
IMAGE_REGISTRY_PATH=
